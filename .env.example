# ===========================
# Docker Compose 环境变量模板
# 复制为 .env 后按需修改（.env 不入仓）
# ===========================

# TimescaleDB / PostgreSQL
POSTGRES_DB=iov_platform
POSTGRES_USER=iov_admin
POSTGRES_PASSWORD=change_me_pg_123

# EMQX Dashboard
EMQX_DASHBOARD__DEFAULT_USERNAME=admin
EMQX_DASHBOARD__DEFAULT_PASSWORD=public

# Redis
# 宿主机端口默认用 6380，避免和本机 Homebrew Redis 的 6379 冲突。
REDIS_PORT=6380
REDIS_PASSWORD=change_me_redis_123

# 高德地图 (前端本地开发使用，不入仓)
VITE_AMAP_KEY=your_amap_jsapi_key
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code

# 前端开发服务器配置（Vite）
VITE_API_BASE_URL=http://localhost:8080

# 本地车辆模拟器（后端 local profile）
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=1000
SIMULATOR_VEHICLE_LIMIT=20

# ==================== AI Integration (Spring AI OpenAI-compatible) ====================
AI_CHAT_PROVIDER=stepfun
AI_CHAT_API_KEY=your_stepfun_api_key_here
AI_CHAT_BASE_URL=https://api.stepfun.com/step_plan
AI_CHAT_COMPLETIONS_PATH=/v1/chat/completions
AI_CHAT_MODEL=step-3.7-flash
AI_CHAT_TEMPERATURE=0.2
AI_CHAT_MAX_TOKENS=2400
AI_CHAT_RESPONSE_FORMAT=json_object
AI_CHAT_REASONING_EFFORT=
AI_CHAT_STREAM_USAGE=false

# Backward-compatible Qwen variables. The app only uses these if AI_CHAT_* is absent.
AI_QWEN_API_KEY=your_qwen_api_key_here
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# Dashboard capture settings. Use auto so text-only models do not receive image input.
AI_DASHBOARD_IMAGE_MODE=auto
AI_DASHBOARD_FRONTEND_BASE_URL=http://localhost:5173
AI_DASHBOARD_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
AI_DASHBOARD_SCREENSHOT_TIMEOUT_MS=15000
